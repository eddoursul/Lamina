# Writes a C++ source that holds files as byte arrays, so a program needs none of them beside it: the web app
# (src/server/web), the server's presets (examples/*.json), the engine's expert profiles (data/expert-profiles/*.bin).
# Run by CMake at build time:
#   cmake -DDIR=<dir> -DGLOB=<pattern below it> -DOUT=<file.cpp> -DFUNC=<name> -P embed_files.cmake
# The source defines `const lamina::EmbeddedFile* lamina::FUNC(std::string_view path)` (include/lamina/embedded.hpp):
# the file of that path below DIR ("index.html", "fonts/outfit-latin-wght.woff2"), or nullptr; and
# `std::span<const lamina::EmbeddedFile> lamina::FUNC_all()`, every one in the path's order.  Each array ends in a 0
# the size leaves out, so a text file is also a C string.
file(GLOB_RECURSE _files RELATIVE "${DIR}" "${DIR}/${GLOB}")
list(SORT _files)
set(_body "// generated by cmake/embed_files.cmake from ${DIR}: do not edit\n#include \"lamina/embedded.hpp\"\n\nnamespace lamina {\nnamespace {\n")
set(_table "")
set(_i 0)
foreach(_f IN LISTS _files)
  file(READ "${DIR}/${_f}" _hex HEX)
  string(LENGTH "${_hex}" _n)
  math(EXPR _size "${_n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" _bytes "${_bytes}")
  string(APPEND _body "const unsigned char f${_i}[] = {\n${_bytes}0};\n")
  string(APPEND _table "    {\"${_f}\", {reinterpret_cast<const char*>(f${_i}), ${_size}}},\n")
  math(EXPR _i "${_i} + 1")
endforeach()
if(_i EQUAL 0)
  message(FATAL_ERROR "embed_files.cmake: no file matches ${DIR}/${GLOB}")
endif()
string(APPEND _body "const EmbeddedFile files[] = {\n${_table}};\n\n}  // namespace\n\n")
string(APPEND _body "const EmbeddedFile* ${FUNC}(std::string_view path) {\n    for (const auto& f : files)\n        if (f.path == path) return &f;\n    return nullptr;\n}\n\n")
string(APPEND _body "std::span<const EmbeddedFile> ${FUNC}_all() { return files; }\n\n}  // namespace lamina\n")
file(WRITE "${OUT}.tmp" "${_body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
