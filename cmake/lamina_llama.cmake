# The llama.cpp the programs build against: ggml (the CPU experts, ggml-cuda's MMQ kernels, the image encoder's CPU
# path, gguf, the type traits), the libraries it vendors (cpp-httplib, nlohmann/json, stb_image), and src/unicode.cpp,
# the reference pretokenize_parity checks the server's pre-tokenizers and code point tables against (that test's
# alone).
#
#   lamina_llama_cpp(<var>)  ->  <var>: third_party/llama.cpp of this checkout, at the pinned commit
#
# The folder is used when its .lamina-commit names the pinned commit. Otherwise GitHub's zip of that commit is
# downloaded, checked by its SHA-256, and unpacked there without tools/ui (llama.cpp's web app: its deep paths pass
# Windows' 260-character limit); a folder an earlier pin left (its .lamina-commit names another commit) is replaced, one
# without that file is refused. The Python tools take gguf-py from the same folder (tools/_paths.py).
set(LAMINA_LLAMA_COMMIT 3cf03257f219afbe7334045ff7c6a06ac68c627d)   # b11062; third_party/ggml/VERSION.txt
set(LAMINA_LLAMA_SHA256 cbe23c594282ead2937abb3f008e51fcec4609d9256652fff42c7cc1c21ea47b)

function(lamina_llama_cpp out)
  get_filename_component(_tp "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../third_party" ABSOLUTE)
  set(_dir "${_tp}/llama.cpp")
  set(${out} "${_dir}" PARENT_SCOPE)
  set(_mark "${_dir}/.lamina-commit")
  macro(_lamina_llama_current _var)
    set(${_var} "")
    if(EXISTS "${_mark}")
      file(STRINGS "${_mark}" ${_var} LIMIT_COUNT 1)
    endif()
  endmacro()
  _lamina_llama_current(_have)
  if(_have STREQUAL LAMINA_LLAMA_COMMIT)
    return()
  endif()
  # one configure at a time unpacks it (two build folders configured at once share the folder)
  file(LOCK "${_tp}/llama.cpp.lock" GUARD FUNCTION TIMEOUT 1800)
  _lamina_llama_current(_have)
  if(_have STREQUAL LAMINA_LLAMA_COMMIT)
    return()
  endif()
  if(EXISTS "${_dir}" AND NOT EXISTS "${_mark}")
    message(FATAL_ERROR "${_dir} holds a llama.cpp this build did not download (no .lamina-commit in it). Move it "
                        "away, or name a checkout with -DLAMINA_GGML_DIR=<folder> (another commit than "
                        "${LAMINA_LLAMA_COMMIT} builds without the kernels tied to that one's text).")
  endif()
  string(SUBSTRING "${LAMINA_LLAMA_COMMIT}" 0 8 _short)
  set(_zip "${_tp}/llama.cpp-${_short}.zip")
  set(_url "https://github.com/ggml-org/llama.cpp/archive/${LAMINA_LLAMA_COMMIT}.zip")
  message(STATUS "llama.cpp ${_short}: downloading ${_url}")
  foreach(_try 1 2 3)
    file(DOWNLOAD "${_url}" "${_zip}" STATUS _st TLS_VERIFY ON INACTIVITY_TIMEOUT 60)
    list(GET _st 0 _code)
    if(_code EQUAL 0)
      file(SHA256 "${_zip}" _sha)
      if(_sha STREQUAL LAMINA_LLAMA_SHA256)
        break()
      endif()
      set(_st "1;its SHA-256 is ${_sha}, not ${LAMINA_LLAMA_SHA256}")
    endif()
    file(REMOVE "${_zip}")
    list(GET _st 1 _why)
    if(_try EQUAL 3)
      message(FATAL_ERROR "llama.cpp ${_short}: the download failed (${_why}). Configure again, or put a copy of "
                          "that commit in ${_dir} with a .lamina-commit file holding ${LAMINA_LLAMA_COMMIT}.")
    endif()
    message(STATUS "llama.cpp ${_short}: the download failed (${_why}); trying again")
  endforeach()
  # every entry of the archive but tools/ui, as the patterns of its folders and files one level down (two in tools/).
  # One MATCHES a condition where its groups are read: if() evaluates them all, and a failed one clears CMAKE_MATCH_1.
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${_zip}" OUTPUT_VARIABLE _list RESULT_VARIABLE _r)
  if(NOT _r EQUAL 0)
    message(FATAL_ERROR "llama.cpp ${_short}: ${_zip} cannot be read")
  endif()
  string(REPLACE "\n" ";" _list "${_list}")
  set(_keep "")
  foreach(_e IN LISTS _list)
    if(_e MATCHES "^[^/]+/tools/ui(/|$)" OR _e MATCHES "^[^/]+/tools/?$")
      continue()
    elseif(_e MATCHES "^([^/]+/tools/[^/]+)")
      list(APPEND _keep "${CMAKE_MATCH_1}")
    elseif(_e MATCHES "^([^/]+/[^/]+)")
      list(APPEND _keep "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _keep)
  set(_tmp "${_tp}/llama.cpp.unpack")
  file(REMOVE_RECURSE "${_tmp}")
  file(ARCHIVE_EXTRACT INPUT "${_zip}" DESTINATION "${_tmp}" PATTERNS ${_keep})
  file(GLOB _top LIST_DIRECTORIES true "${_tmp}/*")
  list(LENGTH _top _n)
  if(NOT _n EQUAL 1)
    message(FATAL_ERROR "llama.cpp ${_short}: ${_zip} does not hold one folder")
  endif()
  if(EXISTS "${_dir}")
    message(STATUS "llama.cpp ${_short}: replacing ${_have} in ${_dir}")
    file(REMOVE_RECURSE "${_dir}")
  endif()
  foreach(_try 1 2 3 4 5)   # an antivirus scanner can still hold a file of the fresh unpack
    file(RENAME "${_top}" "${_dir}" RESULT _r)
    if(_r EQUAL 0)
      break()
    elseif(_try EQUAL 5)
      message(FATAL_ERROR "llama.cpp ${_short}: ${_top} cannot be moved to ${_dir}: ${_r}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
  endforeach()
  file(REMOVE_RECURSE "${_tmp}")
  file(REMOVE "${_zip}")
  file(WRITE "${_mark}" "${LAMINA_LLAMA_COMMIT}\n")
  message(STATUS "llama.cpp ${_short}: ${_dir}")
endfunction()
